SMTP_PASS=your-app-password
NOTIFY_EMAIL_TO=team@globalssc.com
NOTIFY_EMAIL_FROM="GLOBALSSC <your-email@gmail.com>"

# ===== WhatsApp Cloud API (Meta) =====
