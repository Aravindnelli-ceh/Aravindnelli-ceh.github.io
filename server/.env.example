# ===== Server =====
PORT=3000

# ===== Admin dashboard =====
ADMIN_KEY=change_this_admin_key

# ===== Customer-facing WhatsApp click-to-chat number =====
GLOBALSSC_WHATSAPP_DISPLAY_NUMBER=916309579202

# ===== Email notifications (SMTP) =====
