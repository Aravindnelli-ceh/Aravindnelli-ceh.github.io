<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GLOBALSSC — Rakhi Special 2040 | Any Website ₹3,999</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Manrope:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --void:#08050a;
    --void-2:#0f0810;
    --crimson:#8a0f22;
    --crimson-deep:#4a0812;
    --gold:#f2c464;
    --gold-bright:#ffe08a;
    --gold-dim:#8a6d2f;
    --violet:#7c4dff;
    --ink:#f3ead9;
    --ink-dim:#a89a8a;
    --glass:rgba(255,240,210,0.04);
    --glass-border:rgba(242,196,100,0.18);
    --danger:#ff4d6d;
    --ok:#5be0a0;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--void);
    color:var(--ink);
    font-family:'Manrope',sans-serif;
    overflow-x:hidden;
    position:relative;
    min-height:100vh;
  }
  ::selection{background:var(--gold);color:#1a0a0a;}

  /* ambient background */
  .bg-field{
    position:fixed;inset:0;z-index:0;pointer-events:none;
    background:
      radial-gradient(ellipse 120% 60% at 50% -10%, rgba(138,15,34,0.35), transparent 60%),
      radial-gradient(ellipse 80% 50% at 90% 100%, rgba(124,77,255,0.10), transparent 60%),
      radial-gradient(ellipse 60% 40% at 5% 80%, rgba(242,196,100,0.06), transparent 60%),
      var(--void);
  }
  .bg-grid{
    position:fixed;inset:0;z-index:0;pointer-events:none;opacity:0.15;
    background-image:
      linear-gradient(rgba(242,196,100,0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(242,196,100,0.5) 1px, transparent 1px);
    background-size:64px 64px;
    mask-image:radial-gradient(ellipse 70% 50% at 50% 20%, black 30%, transparent 75%);
  }
  .scanline{
    position:fixed;inset:0;z-index:1;pointer-events:none;
    background:linear-gradient(rgba(255,255,255,0) 50%, rgba(0,0,0,0.15) 50%);
    background-size:100% 3px;
    opacity:0.25;
  }
  .noise-sweep{
    position:fixed;top:0;left:-30%;width:30%;height:100%;z-index:1;pointer-events:none;
    background:linear-gradient(100deg, transparent, rgba(242,196,100,0.05), transparent);
    animation:sweep 9s linear infinite;
  }
  @keyframes sweep{ to{ left:130%; } }

  section, header, footer{ position:relative; z-index:2; }

  /* nav */
  header{
    display:flex;align-items:center;justify-content:space-between;
    padding:22px 6vw;
    position:sticky;top:0;z-index:50;
    backdrop-filter:blur(16px) saturate(140%);
    background:rgba(8,5,10,0.55);
    border-bottom:1px solid rgba(242,196,100,0.12);
  }
  .logo{
    font-family:'Orbitron',sans-serif;
    font-weight:900;
    letter-spacing:0.12em;
    font-size:1.15rem;
    color:var(--ink);
    display:flex;align-items:center;gap:10px;
  }
  .logo .mark{
    width:30px;height:30px;border-radius:7px;
    background:conic-gradient(from 210deg, var(--gold-bright), var(--crimson), var(--violet), var(--gold-bright));
    box-shadow:0 0 18px rgba(242,196,100,0.6);
    display:inline-block;
  }
  .logo span.accent{ color:var(--gold); }
  nav.links{ display:flex; gap:32px; }
  nav.links a{
    color:var(--ink-dim); text-decoration:none; font-size:0.82rem;
    letter-spacing:0.08em; text-transform:uppercase; font-weight:600;
    transition:color .25s ease;
  }
  nav.links a:hover{ color:var(--gold); }
  .nav-cta{
    padding:10px 20px;border-radius:100px;
    background:linear-gradient(135deg, var(--gold-bright), var(--gold-dim));
    color:#1a0a06; font-weight:800; font-size:0.78rem; letter-spacing:0.06em;
    text-decoration:none; text-transform:uppercase;
    box-shadow:0 0 24px rgba(242,196,100,0.35);
    white-space:nowrap;
  }
  .burger{ display:none; }

  /* hero */
  .hero{
    min-height:92vh;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;
    padding:80px 6vw 60px;
    position:relative;
  }
  .eyebrow{
    font-family:'Space Mono',monospace;
    font-size:0.78rem; letter-spacing:0.3em; text-transform:uppercase;
    color:var(--gold);
    border:1px solid var(--glass-border);
    padding:8px 18px;border-radius:100px;
    background:var(--glass);
    backdrop-filter:blur(10px);
    margin-bottom:34px;
    display:inline-flex;align-items:center;gap:10px;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 8px var(--gold);animation:pulse 1.8s ease-in-out infinite;}
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:0.3;} }

  .rakhi-stage{
    width:220px;height:220px;
    margin:0 auto 8px;
    perspective:1000px;
  }
  .rakhi{
    width:100%;height:100%;
    position:relative;
    transform-style:preserve-3d;
    animation:floatY 5s ease-in-out infinite, spinY 14s linear infinite;
  }
  @keyframes floatY{ 0%,100%{ transform:translateY(0px) rotateX(8deg); } 50%{ transform:translateY(-18px) rotateX(8deg); } }
  @keyframes spinY{ from{ transform:rotateY(0deg);} to{ transform:rotateY(360deg);} }
  .rakhi-core{
    position:absolute; top:50%; left:50%; width:92px; height:92px;
    margin:-46px 0 0 -46px; border-radius:50%;
    background:
      radial-gradient(circle at 32% 28%, #fff6da, var(--gold-bright) 22%, var(--gold) 48%, var(--crimson-deep) 100%);
    box-shadow:
      0 0 40px rgba(242,196,100,0.75),
      0 0 90px rgba(138,15,34,0.55),
      inset 0 0 20px rgba(255,255,255,0.35);
    transform:translateZ(30px);
  }
  .rakhi-core::after{
    content:'';position:absolute;inset:14px;border-radius:50%;
    background:conic-gradient(from 0deg, rgba(124,77,255,0.5), transparent 30%, rgba(255,255,255,0.4) 50%, transparent 70%, rgba(124,77,255,0.5));
    animation:spinY 4s linear infinite;
    mix-blend-mode:screen;
  }
  .thread{
    position:absolute; top:50%; left:50%;
    width:150px; height:4px; margin-top:-2px;
    background:linear-gradient(90deg, var(--gold-bright), var(--crimson) 70%, transparent);
    border-radius:4px;
    box-shadow:0 0 10px rgba(242,196,100,0.6);
    transform-origin:0 50%;
  }
  .thread:nth-child(2){ transform:rotateZ(0deg) rotateY(0deg) translateZ(10px); }
  .thread:nth-child(3){ transform:rotateZ(51deg) rotateY(0deg) translateZ(10px); }
  .thread:nth-child(4){ transform:rotateZ(102deg) rotateY(0deg) translateZ(10px); }
  .thread:nth-child(5){ transform:rotateZ(153deg) rotateY(0deg) translateZ(10px); }
  .thread:nth-child(6){ transform:rotateZ(204deg) rotateY(0deg) translateZ(10px); }
  .thread:nth-child(7){ transform:rotateZ(255deg) rotateY(0deg) translateZ(10px); }
  .thread:nth-child(8){ transform:rotateZ(306deg) rotateY(0deg) translateZ(10px); }
  .gem{
    position:absolute; top:50%; left:50%; width:14px; height:14px; margin:-7px 0 0 -7px;
    background:var(--violet); border-radius:3px; transform:rotateZ(45deg);
    box-shadow:0 0 14px var(--violet);
  }
  .gem:nth-of-type(1){ transform:translate(70px,-30px) translateZ(20px) rotateZ(45deg); }
  .gem:nth-of-type(2){ transform:translate(-75px,20px) translateZ(20px) rotateZ(45deg); background:var(--gold-bright); box-shadow:0 0 14px var(--gold-bright);}
  .gem:nth-of-type(3){ transform:translate(10px,75px) translateZ(20px) rotateZ(45deg); }

  h1.headline{
    font-family:'Orbitron',sans-serif;
    font-weight:900;
    font-size:clamp(2.4rem, 7vw, 5.2rem);
    line-height:1.02;
    letter-spacing:-0.01em;
    margin:26px 0 20px;
    background:linear-gradient(180deg, #fff8ea 0%, var(--gold-bright) 45%, var(--gold-dim) 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
    text-shadow:0 0 60px rgba(242,196,100,0.25);
  }
  h1.headline .price{
    display:block;
    font-size:clamp(3.2rem, 11vw, 7.5rem);
    background:linear-gradient(135deg, var(--gold-bright), var(--crimson) 60%, var(--violet));
    -webkit-background-clip:text; background-clip:text; color:transparent;
    filter:drop-shadow(0 0 40px rgba(138,15,34,0.5));
  }
  .subhead{
    max-width:620px; margin:0 auto 40px;
    color:var(--ink-dim); font-size:1.08rem; line-height:1.6;
    font-weight:500;
  }
  .hero-ctas{ display:flex; gap:18px; flex-wrap:wrap; justify-content:center; margin-bottom:26px; }
  .btn-primary{
    font-family:'Orbitron',sans-serif;
    padding:19px 40px; border-radius:12px; border:none; cursor:pointer;
    font-weight:800; font-size:0.95rem; letter-spacing:0.05em;
    background:linear-gradient(135deg, var(--gold-bright), var(--gold-dim));
    color:#1c0d06;
    box-shadow:0 0 40px rgba(242,196,100,0.4), 0 8px 30px rgba(0,0,0,0.5);
    transition:transform .2s ease, box-shadow .2s ease;
    text-decoration:none; display:inline-flex; align-items:center; gap:10px;
  }
  .btn-primary:hover{ transform:translateY(-3px); box-shadow:0 0 55px rgba(242,196,100,0.6), 0 12px 34px rgba(0,0,0,0.5); }
  .btn-ghost{
    padding:18px 34px;border-radius:12px;
    background:var(--glass); border:1px solid var(--glass-border);
    backdrop-filter:blur(12px);
    color:var(--ink); font-weight:700; font-size:0.92rem; letter-spacing:0.03em;
    text-decoration:none; display:inline-flex; align-items:center; gap:10px;
    transition:border-color .2s ease, background .2s ease;
  }
  .btn-ghost:hover{ border-color:var(--gold); background:rgba(242,196,100,0.08); }
  .btn-ghost svg{ width:20px;height:20px; }
  .hero-note{ font-family:'Space Mono',monospace; font-size:0.75rem; color:var(--ink-dim); letter-spacing:0.06em; }

  /* section shared */
  .section{ padding:100px 6vw; max-width:1240px; margin:0 auto; }
  .section-head{ text-align:center; max-width:640px; margin:0 auto 56px; }
  .section-eyebrow{
    font-family:'Space Mono',monospace; font-size:0.72rem; letter-spacing:0.28em; text-transform:uppercase;
    color:var(--violet); margin-bottom:14px;
  }
  .section-title{
    font-family:'Orbitron',sans-serif; font-weight:800; font-size:clamp(1.7rem,3.6vw,2.6rem);
    color:var(--ink);
  }
  .section-sub{ color:var(--ink-dim); margin-top:14px; line-height:1.6; }

  /* offer grid */
  .offer-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:22px; }
  .glass-card{
    background:linear-gradient(160deg, rgba(255,240,210,0.06), rgba(255,240,210,0.015));
    border:1px solid var(--glass-border);
    border-radius:18px; padding:30px 26px;
    backdrop-filter:blur(14px);
    position:relative; overflow:hidden;
    transition:transform .3s ease, border-color .3s ease;
  }
  .glass-card::before{
    content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;
    background:radial-gradient(circle at 30% 20%, rgba(242,196,100,0.08), transparent 55%);
    pointer-events:none;
  }
  .glass-card:hover{ transform:translateY(-6px); border-color:rgba(242,196,100,0.4); }
  .glass-card .icon{
    width:46px;height:46px;border-radius:12px;margin-bottom:18px;
    background:linear-gradient(135deg, var(--crimson), var(--violet));
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 0 20px rgba(138,15,34,0.5);
    font-size:1.3rem;
  }
  .glass-card h3{ font-family:'Orbitron',sans-serif; font-size:1.02rem; margin-bottom:10px; color:var(--gold-bright); }
  .glass-card p{ color:var(--ink-dim); font-size:0.92rem; line-height:1.55; }

  /* pricing strip */
  .price-strip{
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:24px;
    background:linear-gradient(120deg, rgba(138,15,34,0.25), rgba(124,77,255,0.08));
    border:1px solid var(--glass-border);
    border-radius:22px; padding:40px 44px; margin-top:50px;
    position:relative; overflow:hidden;
  }
  .price-strip::after{
    content:'';position:absolute;inset:0;
    background:radial-gradient(circle at 90% 10%, rgba(242,196,100,0.15), transparent 60%);
  }
  .price-strip .left{ position:relative; z-index:1; }
  .price-strip .tag{ font-family:'Space Mono',monospace; font-size:0.75rem; color:var(--gold); letter-spacing:0.2em; text-transform:uppercase; }
  .price-strip .amount{ font-family:'Orbitron',sans-serif; font-size:3rem; font-weight:900; color:var(--ink); margin-top:6px; }
  .price-strip .amount .strike{ text-decoration:line-through; color:var(--ink-dim); font-size:1.4rem; margin-right:14px; font-weight:600; }
  .price-strip .right{ position:relative; z-index:1; }

  /* enquiry section */
  .enquiry-wrap{
    display:grid; grid-template-columns:1fr 1.1fr; gap:50px; align-items:flex-start;
  }
  @media(max-width:860px){ .enquiry-wrap{ grid-template-columns:1fr; } }
  .enquiry-side h2{ font-family:'Orbitron',sans-serif; font-size:1.9rem; margin-bottom:18px; color:var(--ink); line-height:1.2; }
  .enquiry-side p{ color:var(--ink-dim); line-height:1.7; margin-bottom:26px; }
  .mini-steps{ list-style:none; display:flex; flex-direction:column; gap:16px; }
  .mini-steps li{ display:flex; gap:14px; align-items:flex-start; color:var(--ink-dim); font-size:0.9rem; }
  .mini-steps .n{
    flex-shrink:0; width:28px;height:28px;border-radius:8px;
    background:var(--glass); border:1px solid var(--glass-border);
    display:flex;align-items:center;justify-content:center;
    font-family:'Space Mono',monospace; color:var(--gold); font-size:0.8rem;
  }

  .form-card{
    background:linear-gradient(160deg, rgba(255,240,210,0.055), rgba(255,240,210,0.01));
    border:1px solid var(--glass-border); border-radius:22px; padding:38px;
    backdrop-filter:blur(18px);
    box-shadow:0 20px 60px rgba(0,0,0,0.4);
  }
  .field{ margin-bottom:20px; }
  .field label{
    display:block; font-size:0.78rem; letter-spacing:0.08em; text-transform:uppercase;
    color:var(--gold); margin-bottom:9px; font-weight:700;
  }
  .field input, .field select, .field textarea{
    width:100%; padding:14px 16px; border-radius:10px;
    background:rgba(0,0,0,0.35); border:1px solid rgba(242,196,100,0.2);
    color:var(--ink); font-family:'Manrope',sans-serif; font-size:0.95rem;
    outline:none; transition:border-color .2s ease, box-shadow .2s ease;
  }
  .field select{ appearance:none; -webkit-appearance:none; background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='9'><path d='M1 1l6 6 6-6' stroke='%23f2c464' stroke-width='2' fill='none'/></svg>"); background-repeat:no-repeat; background-position:right 16px center; }
  .field textarea{ min-height:100px; resize:vertical; font-family:'Manrope',sans-serif; }
  .field input:focus, .field select:focus, .field textarea:focus{
    border-color:var(--gold); box-shadow:0 0 0 3px rgba(242,196,100,0.15);
  }
  .field .err{ color:var(--danger); font-size:0.78rem; margin-top:6px; display:none; font-weight:600; }
  .field.invalid input, .field.invalid select, .field.invalid textarea{ border-color:var(--danger); }
  .field.invalid .err{ display:block; }
  .form-submit{
    width:100%; margin-top:6px;
    font-family:'Orbitron',sans-serif; padding:18px; border-radius:12px; border:none; cursor:pointer;
    font-weight:800; font-size:0.95rem; letter-spacing:0.04em;
    background:linear-gradient(135deg, var(--gold-bright), var(--crimson));
    color:#1c0d06;
    box-shadow:0 0 30px rgba(242,196,100,0.3);
    transition:transform .2s ease;
    display:flex;align-items:center;justify-content:center;gap:10px;
  }
  .form-submit:hover{ transform:translateY(-2px); }
  .form-submit:disabled{ opacity:0.6; cursor:not-allowed; transform:none; }
  .form-foot-note{ text-align:center; font-size:0.76rem; color:var(--ink-dim); margin-top:14px; font-family:'Space Mono',monospace; }

  .success-panel{
    display:none; text-align:center; padding:20px 6px;
  }
  .success-panel.show{ display:block; animation:fadeUp .5s ease; }
  @keyframes fadeUp{ from{opacity:0;transform:translateY(14px);} to{opacity:1;transform:translateY(0);} }
  .success-panel .check{
    width:70px;height:70px;border-radius:50%;margin:0 auto 20px;
    background:radial-gradient(circle, rgba(91,224,160,0.25), transparent 70%);
    border:2px solid var(--ok); display:flex;align-items:center;justify-content:center;
    box-shadow:0 0 30px rgba(91,224,160,0.4);
  }
  .success-panel h3{ font-family:'Orbitron',sans-serif; color:var(--ok); font-size:1.3rem; margin-bottom:10px; }
  .success-panel p{ color:var(--ink-dim); margin-bottom:22px; line-height:1.6; }

  /* whatsapp floating */
  .wa-float{
    position:fixed; bottom:26px; right:26px; z-index:60;
    width:60px;height:60px;border-radius:50%;
    background:linear-gradient(135deg,#25d366,#128c4a);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 0 30px rgba(37,211,102,0.5), 0 8px 20px rgba(0,0,0,0.4);
    text-decoration:none; animation:floatBtn 3s ease-in-out infinite;
  }
  @keyframes floatBtn{ 0%,100%{transform:translateY(0);} 50%{transform:translateY(-8px);} }
  .wa-float svg{ width:30px;height:30px; }

  /* admin */
  .admin-toggle{
    position:fixed; bottom:26px; left:26px; z-index:60;
    padding:10px 16px; border-radius:100px;
    background:var(--glass); border:1px solid var(--glass-border);
    backdrop-filter:blur(12px); color:var(--ink-dim);
    font-family:'Space Mono',monospace; font-size:0.72rem; letter-spacing:0.1em;
    cursor:pointer; text-transform:uppercase;
  }
  .admin-overlay{
    position:fixed; inset:0; z-index:100; display:none;
    background:rgba(4,2,5,0.85); backdrop-filter:blur(8px);
    align-items:center; justify-content:center; padding:5vw;
  }
  .admin-overlay.show{ display:flex; }
  .admin-panel{
    width:100%; max-width:960px; max-height:86vh; overflow-y:auto;
    background:linear-gradient(160deg, rgba(20,10,16,0.96), rgba(10,6,10,0.98));
    border:1px solid var(--glass-border); border-radius:20px; padding:34px;
    box-shadow:0 30px 80px rgba(0,0,0,0.7);
  }
  .admin-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px; }
  .admin-head h2{ font-family:'Orbitron',sans-serif; color:var(--gold-bright); font-size:1.3rem; }
  .admin-close{ background:none;border:1px solid var(--glass-border);color:var(--ink);border-radius:8px;padding:8px 14px;cursor:pointer;font-family:'Space Mono',monospace;font-size:0.8rem;}
  .pin-gate{ text-align:center; padding:30px 0; }
  .pin-gate input{
    width:180px; text-align:center; letter-spacing:0.4em; font-size:1.2rem;
    padding:14px; border-radius:10px; background:rgba(0,0,0,0.4);
    border:1px solid var(--glass-border); color:var(--gold-bright); margin:18px 0;
    font-family:'Space Mono',monospace;
  }
  .lead-table{ width:100%; border-collapse:collapse; font-size:0.85rem; }
  .lead-table th{
    text-align:left; padding:10px 12px; color:var(--gold); font-family:'Space Mono',monospace;
    font-size:0.72rem; letter-spacing:0.08em; text-transform:uppercase;
    border-bottom:1px solid var(--glass-border);
  }
  .lead-table td{ padding:12px; border-bottom:1px solid rgba(242,196,100,0.08); color:var(--ink-dim); vertical-align:top; }
  .lead-table tr:hover td{ background:rgba(242,196,100,0.03); }
  .lead-table .name-cell{ color:var(--ink); font-weight:700; }
  .badge{ padding:3px 10px;border-radius:100px;font-size:0.7rem;background:rgba(124,77,255,0.15);color:#bfa8ff;border:1px solid rgba(124,77,255,0.3); }
  .admin-empty{ text-align:center; padding:50px 0; color:var(--ink-dim); }
  .admin-stats{ display:flex; gap:14px; margin-bottom:20px; flex-wrap:wrap; }
  .admin-stats .stat{ background:var(--glass); border:1px solid var(--glass-border); border-radius:12px; padding:14px 20px; }
  .admin-stats .stat .num{ font-family:'Orbitron',sans-serif; font-size:1.4rem; color:var(--gold-bright); }
  .admin-stats .stat .lbl{ font-size:0.7rem; color:var(--ink-dim); text-transform:uppercase; letter-spacing:0.06em; }
  .admin-actions{ display:flex; gap:10px; margin-bottom:18px; flex-wrap:wrap; }
  .admin-btn{
    background:var(--glass); border:1px solid var(--glass-border); color:var(--ink);
    padding:9px 16px; border-radius:8px; cursor:pointer; font-size:0.78rem; font-family:'Manrope',sans-serif; font-weight:700;
  }
  .admin-btn:hover{ border-color:var(--gold); color:var(--gold); }
  .table-wrap{ overflow-x:auto; }
  .arch-note{
    margin-top:26px; padding:16px 18px; border-radius:12px;
