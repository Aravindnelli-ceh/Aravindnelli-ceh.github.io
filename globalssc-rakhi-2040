<script>
/* ====== CONFIG — replace with your real WhatsApp Business number (country code + number, no + or spaces) ====== */
const GLOBALSSC_WHATSAPP_NUMBER = "916309579202"; // GLOBALSSC WhatsApp number
const ADMIN_PIN = "3999";

function buildWaMessage(data){
  return `Hi GLOBALSSC! I want the Rakhi Special Offer — Any Website ₹3,999.%0A%0A` +
    `*Name:* ${data.name}%0A` +
    `*Phone:* ${data.phone}%0A` +
    `*Business Type:* ${data.btype}%0A` +
    `*Requirements:* ${data.requirements}`;
}
function waLink(msg){
  return `https://wa.me/${GLOBALSSC_WHATSAPP_NUMBER}?text=${msg}`;
}

// generic hero/float WA buttons use a default message
const defaultMsg = encodeURIComponent("Hi GLOBALSSC! I'm interested in the Rakhi Special Offer — Any Website ₹3,999. Please share details.");
document.getElementById('heroWaBtn').href = `https://wa.me/${GLOBALSSC_WHATSAPP_NUMBER}?text=${defaultMsg}`;
document.getElementById('floatWaBtn').href = `https://wa.me/${GLOBALSSC_WHATSAPP_NUMBER}?text=${defaultMsg}`;

function escapeHtml(str){
  return String(str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function validateField(fieldId, condition){
  const el = document.getElementById(fieldId);
  if(condition){ el.classList.remove('invalid'); return true; }
  el.classList.add('invalid'); return false;
}

const form = document.getElementById('enquiryForm');
const submitBtn = document.getElementById('submitBtn');

form.addEventListener('submit', async (e) => {
  e.preventDefault();

  const name = document.getElementById('name').value.trim();
  const phone = document.getElementById('phone').value.trim();
  const btype = document.getElementById('btype').value;
  const requirements = document.getElementById('requirements').value.trim();

  const phoneClean = phone.replace(/\D/g,'');
  let valid = true;
  valid = validateField('f-name', name.length >= 2) && valid;
  valid = validateField('f-phone', /^[6-9]\d{9}$/.test(phoneClean)) && valid;
  valid = validateField('f-btype', btype.length > 0) && valid;
  valid = validateField('f-req', requirements.length >= 10) && valid;

  if(!valid) return;

  submitBtn.disabled = true;
  submitBtn.textContent = 'SAVING...';

  const enquiry = {
    name: escapeHtml(name),
    phone: phoneClean,
    btype: escapeHtml(btype),
    requirements: escapeHtml(requirements),
    timestamp: new Date().toISOString(),
    source: 'Rakhi Special 2040 Landing Page'
  };

  const id = 'enquiry:' + Date.now() + '-' + Math.random().toString(36).slice(2,8);

  try{
    await window.storage.set(id, JSON.stringify(enquiry), true);
  }catch(err){
    console.error('Storage failed', err);
    alert('Could not save your enquiry right now. Please try again, or message us directly on WhatsApp.');
    submitBtn.disabled = false;
    submitBtn.textContent = 'GET ₹3,999 OFFER';
    return;
  }

  // simulate email notification dispatch (real SMTP requires a backend — see admin note)
  console.log('[email-notification] New enquiry would be emailed to team@globalssc.com', enquiry);

  const msg = buildWaMessage(enquiry);
  document.getElementById('successWaBtn').href = waLink(msg);

  form.style.display = 'none';
  document.getElementById('successPanel').classList.add('show');

  submitBtn.disabled = false;
  submitBtn.textContent = 'GET ₹3,999 OFFER';
});

document.getElementById('newEnquiryBtn').addEventListener('click', () => {
  form.reset();
  document.querySelectorAll('.field').forEach(f => f.classList.remove('invalid'));
  document.getElementById('successPanel').classList.remove('show');
  form.style.display = 'block';
});

/* ---------- ADMIN DASHBOARD ---------- */
const adminOverlay = document.getElementById('adminOverlay');
document.getElementById('adminToggle').addEventListener('click', () => adminOverlay.classList.add('show'));
document.getElementById('adminClose').addEventListener('click', () => adminOverlay.classList.remove('show'));

document.getElementById('pinSubmit').addEventListener('click', unlockAdmin);
document.getElementById('pinInput').addEventListener('keydown', (e) => { if(e.key === 'Enter') unlockAdmin(); });

function unlockAdmin(){
  const val = document.getElementById('pinInput').value;
  if(val === ADMIN_PIN){
    document.getElementById('pinGate').style.display = 'none';
    document.getElementById('dashContent').style.display = 'block';
    loadLeads();
  } else {
    document.getElementById('pinInput').style.borderColor = '#ff4d6d';
    document.getElementById('pinInput').value = '';
  }
}

let currentLeads = [];

async function loadLeads(){
  const tbody = document.getElementById('leadTbody');
  tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Loading enquiries...</td></tr>';
  try{
    const list = await window.storage.list('enquiry:', true);
    const keys = (list && list.keys) ? list.keys : [];
    const leads = [];
    for(const k of keys){
      try{
        const res = await window.storage.get(k, true);
        if(res && res.value){ leads.push(JSON.parse(res.value)); }
      }catch(e){ /* skip unreadable key */ }
    }
    leads.sort((a,b) => new Date(b.timestamp) - new Date(a.timestamp));
    currentLeads = leads;
    renderLeads(leads);
  }catch(err){
    console.error(err);
    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Could not load enquiries.</td></tr>';
  }
}

function renderLeads(leads){
  const tbody = document.getElementById('leadTbody');
  const empty = document.getElementById('emptyState');
  document.getElementById('statTotal').textContent = leads.length;
  const today = new Date().toDateString();
  document.getElementById('statToday').textContent = leads.filter(l => new Date(l.timestamp).toDateString() === today).length;

  if(leads.length === 0){
    tbody.innerHTML = '';
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';
  tbody.innerHTML = leads.map(l => `
    <tr>
      <td class="name-cell">${l.name}</td>
      <td>${l.phone}</td>
      <td><span class="badge">${l.btype}</span></td>
      <td>${l.requirements}</td>
      <td>${new Date(l.timestamp).toLocaleString('en-IN')}</td>
    </tr>
  `).join('');
}

document.getElementById('refreshBtn').addEventListener('click', loadLeads);

document.getElementById('exportBtn').addEventListener('click', () => {
  if(currentLeads.length === 0){ alert('No enquiries to export yet.'); return; }
  const header = 'Name,Phone,Business Type,Requirements,Received\n';
  const rows = currentLeads.map(l =>
    [l.name, l.phone, l.btype, l.requirements.replace(/,/g,';').replace(/\n/g,' '), l.timestamp]
      .map(v => `"${String(v).replace(/"/g,'""')}"`).join(',')
  ).join('\n');
  const blob = new Blob([header + rows], {type:'text/csv'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'globalssc-rakhi-enquiries.csv';
  a.click();
  URL.revokeObjectURL(url);
});
</script>

