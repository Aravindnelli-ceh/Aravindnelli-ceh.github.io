# Get these from https://dashboard.razorpay.com/app/keys
# Start with TEST keys (rzp_test_...) — no real money moves until you switch to live keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

PORT=3000

# Where entries get pinged (country code + number, no + or spaces)
OWNER_WHATSAPP_NUMBER=916309579202

# OPTIONAL — only needed for silent, automatic delivery straight to your WhatsApp.
# Without these, entries still reach you via a pre-filled wa.me link the customer
# taps to send (works immediately, no setup). See README "WhatsApp notifications".
# Get these from https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
